# Local development. Copy to .env.local for `npm run dev`, or to .env for
# `docker compose up app`, which reads it for the build args. Every variable,
# with what it does and its default, is in docs/configuration.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# Server-hosted audio (Wasabi). Optional: hosting stays off unless all five
# IMPAMP_S3_* variables are set. See docs/wasabi-audio.md.
IMPAMP_S3_ACCESS_KEY_ID=
IMPAMP_S3_SECRET_ACCESS_KEY=
