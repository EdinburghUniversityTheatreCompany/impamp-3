KAMAL_REGISTRY_PASSWORD=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_FILE_PICKER_API_KEY=

GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_DOWNLOADS_API_KEY=

# Server-hosted audio (Wasabi). Optional: leave both empty unless the
# IMPAMP_S3_* settings in config/deploy.yml are in use. .kamal/secrets resolves
# these two from the environment, so a deploy without them fails at
# `kamal secrets` with a missing-variable error; if they resolve to empty
# instead, hosted audio silently stops signing. See docs/wasabi-audio.md.
IMPAMP_S3_ACCESS_KEY_ID=
IMPAMP_S3_SECRET_ACCESS_KEY=
