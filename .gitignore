# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.dist

# fnox — local-only secret references (this repo has non-fnox contributors)
fnox.toml

# vercel
.vercel

# server-sync SQLite database (local development)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated favicon, from icon.svg
/src/app/favicon.ico
/src/generated

certificates

# git worktrees (dev-hooks worktree-per-agent workflow) — never tracked
/.worktrees/
# and the agent harness's own worktrees, which were kept untracked only by
# .git/info/exclude — per-clone, so a fresh checkout saw gigabytes as untracked
.claude/worktrees/

# subagent-driven-development scratch (ledger, briefs, review packages)
/.superpowers/
