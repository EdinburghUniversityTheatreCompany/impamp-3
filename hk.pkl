// dev-env standard (dev-hooks:dev-env-setup) — version tracked via DEV_ENV_VERSION in mise.toml.
// For JS/TypeScript repos.
amends "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    // CI runs `npx prettier --check .` over everything, so this glob has to
    // cover everything prettier claims too. It used to stop at code formats,
    // which let an unformatted .md and .yml through the commit gate and turn
    // the lint job red on a push that had passed locally.
    ["prettier"] {
        glob = List("**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx", "**/*.astro", "**/*.css", "**/*.scss", "**/*.md", "**/*.mdx", "**/*.json", "**/*.yml", "**/*.yaml")
        check = "npx prettier --check {{ files }}"
        fix = "npx prettier --write {{ files }}"
    }
    // Shipped scripts must carry the executable bit IN THE GIT INDEX (mode 100755):
    // with core.fileMode=false a local chmod +x never reaches git, so clones get
    // scripts that die with exit 126 "Permission denied". Detects scripts by shebang
    // (line 1 only) among 100644-mode index entries. Single awk on purpose: hk's
    // internal `sh` chokes on a while/read loop inside $() (kills the script at the
    // assignment even when the substitution exits 0), so keep every intermediate
    // command zero-exit. CI's lint job enforces the same rule (see ci.<stack>.yml),
    // so the gates can't drift.
    ["exec-bit-scripts"] {
        check = "bad=$(git ls-files -s | awk -F'\\t' '$1 ~ /^100644/ { if ((getline line < $2) > 0 && line ~ /^#!/) print $2; close($2) }'); if [ -n \"$bad\" ]; then echo 'Shebang scripts missing the executable bit in the git index. Fix: git update-index --chmod=+x <file>'; echo \"$bad\"; exit 1; fi"
    }
    // Toolchain + service versions are pinned in several files at once, because different
    // consumers read different ones: mise.toml for local dev, the .<lang>-version files for
    // CI's setup-* actions, the Dockerfile ARGs for the production image, and the `image:` tags
    // in a compose/deploy manifest for what production runs versus what CI tests against.
    // Nothing makes them agree, so a bump that misses one file is silent — the image builds on a
    // different Ruby than the tests ran on, or the suite goes green against a database server
    // nobody deploys. The script checks only the files that exist and prints what it skipped;
    // CI's `versions` job runs the same script, so the two gates can't drift. Extend the glob if
    // this repo pins a version somewhere else.
    ["versions"] {
        glob = List("mise.toml", ".node-version", "package.json", "Dockerfile*", "Containerfile*", "docker-compose.yml", "compose.yaml", "config/deploy.yml", ".devcontainer/compose.yaml", ".github/workflows/*.yml")
        // `Dockerfile*`, not `Dockerfile`: since v24 the script reads every one of them,
        // and this repo has two. A glob naming only the production image would leave a
        // commit touching just `Dockerfile.dev` firing nothing — which is the half of the
        // old `extra-dockerfiles` step worth keeping. The script itself is a shared
        // template and is never hand-edited; this glob is ours.
        check = "bash scripts/check_version_sync.sh"
    }
    // --- Audits (duplication) ---------------------------------------------------
    // jscpd 5.x via npx; config in `.jscpd.json`. `-f` scopes to code formats
    // (no config equivalent) so docs/yaml aren't flagged. (See dev-env-setup SKILL.md.)
    // The version-cooldown policy (latest on a 4-day cooldown, floored at v5) and the
    // offline fallback live in scripts/run-jscpd.sh, shared with the CI audit job so the
    // local and CI gates can't drift.
    // ESLint and the unit suite: CI runs both (the `unit` job), and this file
    // ran neither — so a lint error or a failing test committed cleanly and was
    // only caught after push. Every other gate here carries a comment claiming
    // CI/pre-commit parity; these two were the exception, and they are the two
    // most likely to catch a real regression.
    ["eslint"] {
        glob = List("**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx")
        check = "npx eslint {{ files }}"
        fix = "npx eslint --fix {{ files }}"
    }
    // Not glob-gated to the changed files: a change in one module breaks tests
    // in another, which is the whole reason to run them.
    ["vitest"] {
        glob = List("**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx")
        check = "npx vitest run"
    }
    // TypeScript. Enforced before this only as a side effect of `npm run build`
    // inside the e2e job's webServer, which is the slowest thing in the
    // pipeline and says nothing about why it is type-checking. Some guards in
    // this codebase *are* types — profileWire.ts's exhaustiveness assertion is
    // the whole of "adding a field to Profile does not put it on the wire" —
    // and a developer running vitest and eslint saw green with one broken.
    // Whole-project like vitest, and about four seconds.
    //
    // `npm run typecheck` rather than a bare `npx tsc --noEmit`, because the
    // tree does not type-check from a clean checkout on its own:
    // src/generated/build-info.json is written by a script and gitignored, and
    // two modules import it. The npm script's `pretypecheck` hook generates it
    // first, so this gate and CI's both run the same self-sufficient command.
    // Calling tsc directly here is what let a green local run push a red CI.
    ["tsc"] {
        glob = List("**/*.ts", "**/*.tsx")
        check = "npm run typecheck"
    }
    ["jscpd"] {
        glob = List("**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx", "**/*.css", "**/*.scss")
        check = "bash scripts/run-jscpd.sh javascript,typescript,css,scss"
    }
    // GitHub Actions workflow linter — schema/expression/`needs:` correctness that SHA-pinning
    // and zizmor don't cover (typo'd keys, bad ${{ }} refs, undefined job deps). hk builtin,
    // glob-gated to .github/workflows/*.yml|yaml; needs `actionlint` from mise (mise.toml).
    // `-shellcheck=` turns OFF actionlint's shellcheck-of-`run:` pass: our run: blocks
    // deliberately word-split (`shellcheck $files`) which trips SC2086, and real *.sh files are
    // already covered by the dedicated shellcheck step.
    ["actionlint"] = (Builtins.actionlint) {
        check = "actionlint -shellcheck= {{ files }}"
    }
    // GitHub Actions security static analysis. hk builtin — globs .github/workflows/*.yml,
    // .github/dependabot.yml and **/action.yml, so it only fires when a workflow/action file
    // is staged. Flags credential persistence, template injection, over-broad GITHUB_TOKEN
    // permissions, etc. (see the github-actions skill). Needs `zizmor` from mise (mise.toml).
    ["zizmor"] = Builtins.zizmor
    // Every `uses:` must be a commit SHA, and each action must resolve to ONE SHA across all
    // workflows. Neither actionlint nor zizmor flags a tag-pinned action at the default persona,
    // so without this the only check was CI's `audit` job — the one asymmetry left in a file
    // whose whole design is that the local and CI gates cannot drift. The drift it exists to
    // catch (three actions pinned at two SHAs each, because `pinact run -u` reached six of eight
    // jobs) is now caught before the commit rather than one push later.
    ["action-refs"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        check = "bash scripts/check_action_refs.sh"
    }
    // Secret scanning (defense-in-depth alongside fnox). hk builtin.
    ["gitleaks"] = Builtins.gitleaks
    // Block accidentally-committed large files. hk builtin.
    // No exemptions: the one that existed was docs/original-impamp-code.txt, a
    // 616 KB dump of the legacy ImpAmp2 source, and it has been deleted. If
    // something legitimately large arrives, exempt it here *and* in ci.yml's
    // large-file step, which is a second copy of this rule.
    ["check-added-large-files"] = Builtins.check_added_large_files
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    // `check` is the full suite CI runs. The audits (jscpd) already run on pre-commit;
    // `check` is just the same set under one name.
    ["check"] {
        steps = linters
    }
}
