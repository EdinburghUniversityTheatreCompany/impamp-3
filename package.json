{
  "name": "impamp-3",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-favicon.js && node scripts/generate-build-info.js",
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "node scripts/start-standalone.js",
    "lint": "eslint .",
    "pretypecheck": "node scripts/generate-build-info.js",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true npm run build",
    "generate-favicon": "node scripts/generate-favicon.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:audio": "playwright test --project=chromium audio-playback.spec.ts",
    "test:e2e:profiles": "playwright test --project=chromium profiles.spec.ts",
    "test:e2e:edit": "playwright test --project=chromium edit-mode.spec.ts",
    "test:e2e:keyboard": "playwright test --project=chromium keyboard-shortcuts.spec.ts",
    "test:e2e:loudness": "playwright test --project=chromium loudness.spec.ts",
    "test:e2e:portrait": "playwright test --project=mobile-portrait",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "@googleworkspace/drive-picker-element": "^0.7.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@react-oauth/google": "^0.13.5",
    "@zip.js/zip.js": "^2.24.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-selector": "^5.0.0",
    "idb": "^8.0.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
