{
  "name": "impamp-3",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-favicon.js && node scripts/generate-build-info.js",
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "node scripts/start-standalone.js",
    "lint": "eslint .",
    "analyze": "ANALYZE=true npm run build",
    "generate-favicon": "node scripts/generate-favicon.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:audio": "playwright test audio-playback.spec.ts",
    "test:e2e:profiles": "playwright test profiles.spec.ts",
    "test:e2e:edit": "playwright test edit-mode.spec.ts",
    "test:e2e:keyboard": "playwright test keyboard-shortcuts.spec.ts",
    "test:e2e:loudness": "playwright test loudness.spec.ts",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@googleworkspace/drive-picker-element": "^0.7.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@react-oauth/google": "^0.13.5",
    "@zip.js/zip.js": "^2.8.47",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-selector": "^4.1.0",
    "idb": "^8.0.3",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
