{
  "name": "impamp-3",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-favicon.js && node scripts/generate-build-info.js",
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "next start",
    "lint": "next lint",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:client": "BUNDLE_ANALYZE=client npm run build",
    "generate-favicon": "node scripts/generate-favicon.js",
    "test:e2e": "playwright test",
    "test:e2e:audio": "playwright test audio-playback.spec.ts",
    "test:e2e:profiles": "playwright test profiles.spec.ts",
    "test:e2e:edit": "playwright test edit-mode.spec.ts",
    "test:e2e:keyboard": "playwright test keyboard-shortcuts.spec.ts",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@googleworkspace/drive-picker-element": "^0.4.4",
    "@hello-pangea/dnd": "^18.0.1",
    "@react-oauth/google": "^0.12.2",
    "@types/uuid": "^10.0.0",
    "@zip.js/zip.js": "^2.8.46",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "google-api-javascript-client": "^0.1.0",
    "idb": "^8.0.3",
    "jwt-decode": "^4.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.4.1",
    "uuid": "^11.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^15.5.23",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/gapi": "^0.0.47",
    "@types/google.picker": "^0.0.50",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.2.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
